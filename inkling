#!/usr/bin/env python3
"""Entrypoint for the Inkling-2-Mini abliterated local LLM toolkit."""

from pathlib import Path
import sys

# Resolve symlinks so PATH installs (e.g. ~/.local/bin/inkling) still locate this repo.
REPO_ROOT = Path(__file__).resolve().parent
if str(REPO_ROOT) not in sys.path:
    sys.path.insert(0, str(REPO_ROOT))

from toolkit.cli import main  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(main(repo_root=REPO_ROOT))
